# ProofCode — persistence + optional LLM fixer backend
# Copy to .env.local (do NOT commit it). Without a Supabase key the engine
# falls back to an in-memory store (scans still run, data is not persisted).

# Supabase Postgres — the persistence backend (your own Supabase project).
# The service_role key is server-side only; it bypasses RLS so the API can
# read/write the `proofcode` + `proofcode_config` tables. Never expose it to
# the browser (do NOT use NEXT_PUBLIC_ for it).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth — Google sign-in (public, browser-side config for the SAME
# Supabase project as above). The anon key is safe to expose in the browser:
# project data is never read with it — the API validates each sign-in
# session's access token server-side on every request. Sign-in is the ONLY
# way into the API (the old API token was removed on 2026-11-04), so these
# must be set on any real deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Workspace owner: the Google account with full access to every project
# (including ones created before sign-in existed). Everyone else who signs
# in sees only their own projects. Server-side only.
OWNER_EMAIL=

# Google Gemini — the primary LLM fixer provider (used when set):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional fallback: OpenRouter or any OpenAI-compatible API
# (used only when GEMINI_API_KEY is empty):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
PROOF_MODEL=openai/gpt-4o-mini